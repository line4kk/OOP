  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Initialize timestamp for unique usernames",
          "if (!pm.collectionVariables.get(\"timestamp\")) {",
          "    pm.collectionVariables.set(\"timestamp\", Date.now());",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "function generatePerformanceReport() {",
          "    let results = [];",
          "    results.push([\"Operation\", \"Time(ms)\", \"Status\"]);",
          "    ",
          "    let operations = [",
          "        { name: \"Admin_Registration\", timeVar: \"admin_registration_time\" },",
          "        { name: \"User_Registration\", timeVar: \"registration_time\" },",
          "        { name: \"User_Authentication\", timeVar: \"auth_time\" },",
          "        { name: \"Get_Current_User\", timeVar: \"get_user_time\" },",
          "        { name: \"Update_Factory_Type\", timeVar: \"update_factory_time\" },",
          "        { name: \"Create_Function_1\", timeVar: \"create_function_1_time\" },",
          "        { name: \"Create_Function_2\", timeVar: \"create_function_2_time\" },",
          "        { name: \"Get_All_Functions\", timeVar: \"get_all_functions_time\" },",
          "        { name: \"Get_Analytic_Functions\", timeVar: \"get_analytic_functions_time\" },",
          "        { name: \"Get_Function_Info\", timeVar: \"get_function_info_time\" },",
          "        { name: \"Update_Function\", timeVar: \"update_function_time\" },",
          "        { name: \"Add_Function_Points\", timeVar: \"add_points_time\" },",
          "        { name: \"Get_Function_Points\", timeVar: \"get_points_time\" },",
          "        { name: \"Add_Points_Again\", timeVar: \"add_points_again_time\" },",
          "        { name: \"Delete_All_Points\", timeVar: \"delete_all_points_time\" },",
          "        { name: \"Create_Composite_Function\", timeVar: \"create_composite_time\" },",
          "        { name: \"Get_Composite_Composition\", timeVar: \"get_composite_composition_time\" },",
          "        { name: \"Function_Sampling\", timeVar: \"sampling_time\" },",
          "        { name: \"Perform_Operation_Add\", timeVar: \"operation_add_time\" },",
          "        { name: \"Perform_Operation_Subtract\", timeVar: \"operation_subtract_time\" },",
          "        { name: \"Perform_Operation_Multiplication\", timeVar: \"operation_multiplication_time\" },",
          "        { name: \"Perform_Operation_Division\", timeVar: \"operation_division_time\" },",
          "        { name: \"Perform_Operation_Derive\", timeVar: \"operation_derive_time\" },",
          "        { name: \"Admin_Get_All_Users\", timeVar: \"admin_get_users_time\" },",
          "        { name: \"Delete_Function\", timeVar: \"delete_function_time\" }",
          "    ];",
          "    ",
          "    operations.forEach(op => {",
          "        let time = pm.collectionVariables.get(op.timeVar);",
          "        if (time) {",
          "            results.push([op.name, parseFloat(time).toFixed(2), \"SUCCESS\"]);",
          "        } else {",
          "            results.push([op.name, \"0.00\", \"NOT_EXECUTED\"]);",
          "        }",
          "    });",
          "    ",
          "    let csvContent = \"\";",
          "    results.forEach(row => {",
          "        csvContent += row.join(\",\") + \"\\n\";",
          "    });",
          "    ",
          "    pm.collectionVariables.set(\"performance_csv\", csvContent);",
          "    ",
          "    console.log(\"=== COMPLETE PERFORMANCE REPORT ===\");",
          "    console.log(csvContent);",
          "    ",
          "    // Calculate statistics",
          "    let times = results.slice(1).filter(row => row[2] === \"SUCCESS\").map(row => parseFloat(row[1]));",
          "    if (times.length > 0) {",
          "        let totalTime = times.reduce((a, b) => a + b, 0);",
          "        let avgTime = totalTime / times.length;",
          "        let maxTime = Math.max(...times);",
          "        let minTime = Math.min(...times);",
          "        ",
          "        console.log(\"=== PERFORMANCE STATISTICS ===\");",
          "        console.log(\"Total Operations: \" + times.length);",
          "        console.log(\"Total Time: \" + totalTime.toFixed(2) + \"ms\");",
          "        console.log(\"Average Time: \" + avgTime.toFixed(2) + \"ms\");",
          "        console.log(\"Fastest Operation: \" + minTime.toFixed(2) + \"ms\");",
          "        console.log(\"Slowest Operation: \" + maxTime.toFixed(2) + \"ms\");",
          "    }",
          "}"
        ]
      }
    }
  ]
}